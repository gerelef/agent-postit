# ──────────────────────────────────────────────────────────────────────────────
# Master .gitignore  (generated by git w init)
# ──────────────────────────────────────────────────────────────────────────────

# ── Operating System ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editor – IntelliJ / PyCharm / JetBrains ──────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/
atlassian-ide-plugin.xml

# ── Editor – Zed ─────────────────────────────────────────────────────────────
# Remove this entry if you intentionally share per-project Zed settings.
.zed/

# ── Editor – VS Code ─────────────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── Editor – Vim / Neovim ────────────────────────────────────────────────────
*.swp
*.swo
*~
.netrwhist
Session.vim
tags

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyo
*.pyd
.python-version

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.virtualenv/
.pyenv/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml
test-results/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.beartype/

# Linters / formatters
.ruff_cache/
.pylint.d/

# Jupyter
.ipynb_checkpoints
profile_default/
ipython_config.py

# PyInstaller
*.manifest
*.spec

# Misc
pip-log.txt
pip-delete-this-directory.txt
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.scrapy
docs/_build/
.pybuilder/

# ── Bash / Shell ──────────────────────────────────────────────────────────────
# (no compiled artefacts; editor leftovers captured above)

# ── C / C++ ───────────────────────────────────────────────────────────────────
*.o
*.ko
*.obj
*.elf
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.out
*.exe
*.app
*.i*86
*.x86_64
*.hex
*.d
*.dSYM/
*.su
*.idb
*.pdb

# ── Clang toolchain ───────────────────────────────────────────────────────────
.clangd/
.cache/clangd/
# compile_commands.json is intentionally left out here;
# uncomment the next line if you generate it via CMake and don't want it tracked:
# compile_commands.json

# ── CMake ─────────────────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/
cmake-build-*/
*.cmake
!CMakeLists.txt
!cmake/

# ── Java / JVM ────────────────────────────────────────────────────────────────
*.class
*.jar
*.war
*.nar
*.ear
hs_err_pid*

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
gradle-app.setting
.gradletasknamecache

# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
**/target/

# ── Linters / static analysis ─────────────────────────────────────────────────
.sonarlint/
.sonarqube/
.scannerwork/
.checkstyle/
.pmd/
.spotbugs/
.eslintcache
.stylelintcache

# ── Secrets / credentials (safety net) ───────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
.env*
!.env.example
!.env.template
secrets/
credentials/

# ── Logs / temporaries ────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# ── Build / output directories ─────────────────────────────────────────────
bin/
obj/
output/
release/
debug/
Debug/
Release/
x64/
x86/

# ── agent-postit runtime / smoke ──────────────────────────────────────────────
# Local notes roots created when dogfooding in-repo. Don't commit them;
# point --root / $POSTIT_ROOT somewhere outside the repo in real use.
.agent-postit/
notes/
data/
smoke_root/
smoke*.out
smoke*.log
smoke*.sh
smoke_pod_root*/
